# ========================================
# SOFTEK Landing Page — .gitignore
# ========================================

# ---------- Sistema Operacional ----------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ---------- Editores / IDEs ----------

# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# JetBrains / IntelliJ
.idea/
*.iml
*.iws
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.netrwhist

# ---------- Logs / Temporários ----------

*.log
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig

# ---------- Cache / Dependências ----------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ---------- Build / Dist ----------

dist/
build/
*.map

# ---------- Ambiente / Configuração local ----------

.env
.env.local
.env.*.local

# ---------- SSL / Certificados ----------

*.pem
*.key
*.crt
*.cert

# ---------- Outros ----------

# Arquivos de pacote comprimido
*.zip
*.tar.gz
*.rar

# Arquivos de imagem temporários
*.psd
*.ai
*.sketch
*.fig

# Arquivos de documentos temporários
~$*
